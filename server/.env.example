PORT=4000
# Interface the API listens on. 127.0.0.1 keeps it local to this computer (recommended).
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/interviewos
AI_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=replace-with-a-long-random-secret
# Milliseconds the API waits for the AI service. Keep these longer than the AI service's
# OLLAMA_TIMEOUT_SECONDS (review) and 2x OLLAMA_TIMEOUT_SECONDS (questions, which may retry once)
# so the AI service can return its labelled fallback before the API gives up. Allowed range 5000-300000.
AI_REVIEW_TIMEOUT_MS=60000
AI_QUESTIONS_TIMEOUT_MS=110000
